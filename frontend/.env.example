# Example environment variables for PMS frontend
# Copy this file to `.env.development` or `.env.production` and adjust values.
# Only VITE_ prefixed variables are exposed to the client.

# Base URL for backend API.
# Development: typically local emulator / functions URL.
VITE_API_BASE_URL=http://localhost:5001/your-firebase-project/us-central1/api

# Production: deployed API endpoint.
# Uncomment and place in `.env.production` (keep only one definition in each actual env file).
# VITE_API_BASE_URL=https://pms-api.up.railway.app

# Add future variables below (remember the VITE_ prefix):
# VITE_AUTH_ENABLED=true
# VITE_FEATURE_FLAG_LEASE_EXPORT=false
